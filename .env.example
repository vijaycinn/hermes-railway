# Required
ADMIN_PASSWORD=changeme

# Hermes provider — at least one API key, e.g.:
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional: show a different release in the admin UI than the built image tag.
# HERMES_REF=v2026.9.24

# Optional: bootstrap OAuth tokens (contents of a local auth.json).
# HERMES_AUTH_JSON_BOOTSTRAP=

# Dashboard auth (server.py proxies the native dashboard behind basic auth).
# HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Optional: override the pinned image tag at deploy time (wins over Dockerfile ARG).
# HERMES_IMAGE_TAG=v2026.9.24
